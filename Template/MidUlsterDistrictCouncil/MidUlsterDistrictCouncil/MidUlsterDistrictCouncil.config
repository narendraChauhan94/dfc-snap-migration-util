        <!-- DD No Pro-Rata -->
        <DDDescription>&lt;table&gt;&lt;tr&gt;&lt;td colspan='2'&gt;%PRODUCTDESCRIPTIONLONG%&lt;/td&gt;&lt;/tr&gt;
            &lt;tr class='TwoCols'&gt;&lt;td class='Left'&gt;Membership start date:&lt;/td&gt;&lt;td class='Right'&gt;%MEMBERSHIPSTARTDATE%&lt;/td&gt;&lt;/tr&gt;
            &lt;tr class='TwoCols'&gt;&lt;td class='Left'&gt;Monthly Direct Debit payment amount:&lt;/td&gt;&lt;td class='Right'&gt;&amp;pound;%MONTHLYMEMBERSHIPFEEPENCE%&lt;/td&gt;&lt;/tr&gt;
            &lt;tr class='TwoCols'&gt;&lt;td class='Left'&gt;1st Direct Debit payment date:&lt;/td&gt;&lt;td class='Right'&gt;%CALCULATEDFIRSTPAYMENTDATE%&lt;/td&gt;&lt;/tr&gt;
            &lt;tr class='TwoCols'&gt;&lt;td class='Left'&gt;%JoiningFeeDescription%:&lt;/td&gt;&lt;td class='Right'&gt;&amp;pound;%JOININGFEEPENCE%&lt;/td&gt;&lt;/tr&gt;
            &lt;tr class='TwoCols'&gt;&lt;td class='Left'&gt;Total first payment:&lt;/td&gt;&lt;td class='Right'&gt;&amp;pound;%CALCULATEDFIRSTPAYMENTAMOUNTPENCE%&lt;/td&gt;&lt;/tr&gt;
            &lt;tr class='TwoCols'&gt;&lt;td class='Left'&gt;Second payment date:&lt;/td&gt;&lt;td class='Right'&gt;%CALCULATEDSECONDPAYMENTDATE%&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td colspan='2'&gt;%AgreeingToText%&lt;/td&gt;&lt;/tr&gt;
            &lt;/table&gt;</DDDescription>
        <DDBankConfirmation>&lt;p class='Text'&gt;Your first payment of &amp;pound;%CALCULATEDFIRSTPAYMENTAMOUNTPENCE% will be taken by us on or just after %CALCULATEDFIRSTPAYMENTDATE%.
            This payment consists of:&lt;/p&gt;&lt;ul&gt;
                &lt;li&gt;&amp;pound;%JOININGFEEPENCE% %JoiningFeeDescription%&lt;/li&gt;
                &lt;li&gt;&amp;pound;%MONTHLYMEMBERSHIPFEEPENCE% membership fee&lt;/li&gt;
            &lt;/ul&gt;&lt;p class='Text'&gt;Subsequent monthly payments of &amp;pound;%MONTHLYMEMBERSHIPFEEPENCE% will commence on %CALCULATEDSECONDPAYMENTDATE% and will continue on or just
            after the same day of each month thereafter&lt;/p&gt;</DDBankConfirmation>
        <AgreeingToText>You are committing to a single &amp;pound;%JOININGFEEPENCE% %JoiningFeeDescription% payment and a further &amp;pound;%MONTHLYMEMBERSHIPFEEPENCE% per month for a minimum of %CONTRACTLENGTHMONTHS% months. After this minimum term your membership payments will continue on a monthly basis.</AgreeingToText>
